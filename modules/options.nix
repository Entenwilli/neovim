{
  globals = {
    autoformat = true;
  };

  opts = {
    backup = false;
    swapfile = false;

    clipboard = "unnamedplus";

    cmdheight = 2;

    relativenumber = true;

    fileencoding = "utf-8";

    expandtab = true;
    shiftwidth = 2;
    tabstop = 2;
    softtabstop = 2;

    number = true;
    numberwidth = 4;

    showmode = false;

    smartcase = true;

    hlsearch = true;
    ignorecase = true;

    wrap = false;

    shell = "fish";

    cursorline = true;
    termguicolors = true;
    winblend = 0;
    wildoptions = "pum";
    pumblend = 5;
    background = "dark";
  };
}
